# Tryb przechowywania danych: knex lub memory
STORAGE=knex

# Połączenie z PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Sekret JWT - minimum 32 znaki
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# Czas ważności tokenu
JWT_EXPIRES_IN=15m

# Port aplikacji
PORT=3000

# Tryb środowiska
NODE_ENV=development

# Wyłączenie dodatkowego sprawdzania kolizji w warstwie aplikacji
DISABLE_APP_OVERLAP_CHECK=false
